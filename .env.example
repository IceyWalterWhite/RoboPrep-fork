# ---------------------------------------------------------------------------
# RoboPrep environment configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API).
#
#   cp .env.example .env.local
#
# Never commit real credentials. `.env*` is gitignored (`.env.example` is not).
# ---------------------------------------------------------------------------

# Public — exposed to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — NEVER prefix with NEXT_PUBLIC_.
# Bypasses Row Level Security. Used by admin scripts only.
SUPABASE_SERVICE_ROLE_KEY=

# Public — canonical site URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coding judge — server-only. `local` is for development only and runs a
# restricted Python subprocess; use Judge0 (or another isolated provider) in
# production. Never prefix secrets with NEXT_PUBLIC_.
JUDGE_PROVIDER=judge0
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
PYTHON_EXECUTABLE=python3
JUDGE_TIMEOUT_MS=15000

# Week 6 ingestion parser (server-only). Leave empty to use the deterministic
# mock parser (dev/CI). Any OpenAI-compatible /chat/completions endpoint works.
INGESTION_LLM_PROVIDER=
INGESTION_LLM_MODEL=
INGESTION_LLM_API_KEY=
INGESTION_LLM_BASE_URL=

# Submission limits (Task 53/54)
INGESTION_MIN_CHARS=50
INGESTION_MAX_CHARS=50000
INGESTION_RATE_LIMIT=5

# Week 8 feature flags (server-only; values: on/off, default on)
FLAG_CODING_JUDGE=
FLAG_INTERVIEW_SUBMISSION=
FLAG_LLM_INGESTION=
FLAG_COMPANY_TRENDS=
# Set to "off" on preview deployments to noindex everything
FLAG_ROBOTS_INDEX=
